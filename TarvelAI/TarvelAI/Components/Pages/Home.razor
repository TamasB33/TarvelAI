@page "/"

<PageTitle>Home - TravelAI</PageTitle>

<HomeHero />

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-2">
    <MudPaper Class="pa-4 d-flex align-center justify-space-between" Style="border-radius: 14px;">
        <MudText Typo="Typo.body1" Style="font-weight: 600;">
            Want to browse trips and hotels directly?
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/explore" Style="text-transform:none;">
            Open Explore
        </MudButton>
    </MudPaper>
</MudContainer>

<div style="position: relative; z-index: 2; background: #fff;">
    <FeaturedDestinations />
    <JourneySteps />
    <Testimonials />
    <NewsletterBanner />
    <Footer />
</div>
