@using TarvelAI.DTOs.Flight

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Form.FlightNumber"       Label="Flight Number"      Variant="Variant.Outlined" />
            <MudTextField @bind-Value="Form.Airline"            Label="Airline"            Variant="Variant.Outlined" />
            <MudTextField @bind-Value="Form.OriginAirport"      Label="Origin (IATA)"      Variant="Variant.Outlined" />
            <MudTextField @bind-Value="Form.DestinationAirport" Label="Destination (IATA)" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="_departureDate" Label="Departure Date" Variant="Variant.Outlined" Editable="true" />
            <MudTimePicker @bind-Time="_departureTime" Label="Departure Time" Variant="Variant.Outlined" Editable="true" />
            <MudDatePicker @bind-Date="_arrivalDate"   Label="Arrival Date"   Variant="Variant.Outlined" Editable="true" />
            <MudTimePicker @bind-Time="_arrivalTime"   Label="Arrival Time"   Variant="Variant.Outlined" Editable="true" />
            <MudTextField @bind-Value="Form.ImageUrl"  Label="Image URL"      Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Flight";
    [Parameter] public CreateFlightDto Form { get; set; } = new();

    private DateTime? _departureDate;
    private TimeSpan? _departureTime;
    private DateTime? _arrivalDate;
    private TimeSpan? _arrivalTime;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _departureDate = Form.DepartureTime != default ? Form.DepartureTime.Date : DateTime.UtcNow.Date;
        _departureTime = Form.DepartureTime != default ? Form.DepartureTime.TimeOfDay : TimeSpan.Zero;
        _arrivalDate   = Form.ArrivalTime   != default ? Form.ArrivalTime.Date   : DateTime.UtcNow.Date;
        _arrivalTime   = Form.ArrivalTime   != default ? Form.ArrivalTime.TimeOfDay : TimeSpan.Zero;
        _initialized = true;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        Form.DepartureTime = (_departureDate ?? DateTime.UtcNow).Date + (_departureTime ?? TimeSpan.Zero);
        Form.ArrivalTime   = (_arrivalDate   ?? DateTime.UtcNow).Date + (_arrivalTime ?? TimeSpan.Zero);
        MudDialog.Close(DialogResult.Ok(Form));
    }
}
