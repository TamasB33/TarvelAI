@page "/trip/{Id:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@using TarvelAI.DTOs.Trip
@using TarvelAI.Models
@using TarvelAI.Repositories
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ITripRepository TripRepository
@inject IDialogService DialogService

<PageTitle>Trip Details - TravelAI</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Style="border-radius: 16px;" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="45%" Class="mt-4" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/explore" Class="mt-4">Back to Explore</MudButton>
    }
    else if (_trip is null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">Trip not found.</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/explore" Class="mt-4">Back to Explore</MudButton>
    }
    else
    {
        <MudPaper Style="border-radius: 20px; overflow: hidden;" Class="mb-5">
            <div style="position:relative;">
                <MudImage Src="@SafeImage(_trip.ImageUrl)" Alt="@_trip.Name" Height="360" ObjectFit="ObjectFit.Cover" Style="width:100%;" />
                <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,.68), rgba(0,0,0,.1));"></div>
                <MudStack Spacing="1" Style="position:absolute; left:24px; right:24px; bottom:24px;">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@_trip.Status.ToString()</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="border-color:#fff;color:#fff;">
                            @($"{_trip.DurationDays} days")
                        </MudChip>
                    </MudStack>
                    <MudText Typo="Typo.h4" Style="font-weight:700; color:#fff;">@_trip.Name</MudText>
                    <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,.92);">@_trip.Destination</MudText>
                </MudStack>
            </div>
        </MudPaper>

        <MudPaper Class="pa-5" Style="border-radius:16px;">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6" Style="font-weight:700;">About this trip</MudText>
                <MudText Typo="Typo.body1" Style="line-height:1.7;">@_trip.Description</MudText>

                <MudDivider />

                <MudGrid Class="mt-1">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Style="color:#637186;">Key details</MudText>
                    </MudItem>
                </MudGrid>
                <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3" Style="border-radius: 12px; background:#f8fafc;">
                        <MudText Typo="Typo.caption" Style="color:#637186;">Price</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@($"{_trip.BasePrice:0.##} €")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3" Style="border-radius: 12px; background:#f8fafc;">
                        <MudText Typo="Typo.caption" Style="color:#637186;">Duration</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@($"{_trip.DurationDays} days")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3" Style="border-radius: 12px; background:#f8fafc;">
                        <MudText Typo="Typo.caption" Style="color:#637186;">Created</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_trip.CreatedAt.ToString("yyyy-MM-dd")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Class="pa-3" Style="border-radius: 12px; background:#f8fafc;">
                        <MudText Typo="Typo.caption" Style="color:#637186;">Created By</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_trip.CreatedBy</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6" Style="font-weight:700;">Book this trip</MudText>
                @if (!string.IsNullOrWhiteSpace(_bookError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_bookError</MudAlert>
                }
                @if (_trip.Status != TripStatus.Available)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        This itinerary is not open for new bookings (current status: @_trip.Status.ToString()).
                    </MudAlert>
                }
                else if (!_isAuthenticated)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Sign in to reserve this trip and see it on My Trips.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Href="/login">Log in to book</MudButton>
                }
                else if (_isBooked)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                        You already have a booking for this trip.
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Href="/my-trips">View My Trips</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        You will confirm on the next step, then enter invoicing details before the booking is finalized.
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="mt-3"
                               OnClick="StartBookingFlowAsync">
                        Book this trip
                    </MudButton>
                }
            </MudStack>
        </MudPaper>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/explore" Class="mt-6">Back to Explore</MudButton>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _bookError;
    private TripDto? _trip;
    private bool _isAuthenticated;
    private bool _isBooked;
    private string? _userId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _bookError = null;
        try
        {
            using var response = await Http.GetAsync($"/api/trips/{Id}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _trip = null;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = "Could not load trip details right now.";
                return;
            }

            _trip = await response.Content.ReadFromJsonAsync<TripDto>();

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            _isBooked = false;
            if (_trip is not null && _isAuthenticated && !string.IsNullOrWhiteSpace(_userId))
            {
                var mine = await TripRepository.GetMyBookedTripsAsync(_userId);
                _isBooked = mine.Any(t => t.Id == Id);
            }
        }
        catch
        {
            _error = "Could not load trip details right now.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartBookingFlowAsync()
    {
        _bookError = null;
        if (_trip is null || string.IsNullOrWhiteSpace(_userId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Book this trip?",
            "You will enter invoicing details on the next step. Your booking is only saved after you complete that form.",
            yesText: "Continue",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            Navigation.NavigateTo($"/book/checkout/{Id}");
        }
    }

    private static string SafeImage(string? imageUrl) =>
        string.IsNullOrWhiteSpace(imageUrl)
            ? "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=1200"
            : imageUrl;
}
